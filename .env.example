# AarogyaFlow AI - Environment Variables
# Keep your API secrets secure. Do not commit actual keys to version control.

# Google Gemini API Key (Free tier compatible)
# Get yours from: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Identifier (Defaults to free-tier fast model)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Open Government Data (data.gov.in) API Key (Optional)
# Register at: https://data.gov.in/
DATA_GOV_IN_API_KEY=

# Server Port
PORT=5173
